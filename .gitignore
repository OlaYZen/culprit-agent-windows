# Virtual environment — agent.ps1 creates it outside the checkout, but never commit one
.venv/
venv/

# Agent credentials — host URL + bearer token, written by agent.ps1 outside the checkout. Never commit.
agent.json

# The agent keeps no database, but never commit one if it appears
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-*

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# The flight recorder (data/flight-recorder.json.gz): runtime state, per machine
data/
